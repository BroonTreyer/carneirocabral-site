---
// Mapa dos três estados (contornos oficiais do IBGE), com as capitais onde o escritório atende.
import { MAPA } from '../data/mapa';
import { CIDADES } from '../data/site';
const { largura: W, altura: H, estados, vizinhos, pontos, rotulos } = MAPA;
const capitalDe: Record<string, string> = { MT: 'cuiaba', GO: 'goiania', DF: 'brasilia' };
const nomeEstado: Record<string, string> = { MT: 'Mato Grosso', GO: 'Goiás', DF: 'Distrito Federal' };
const rotuloCidade: Record<string, { dx: number; dy: number; anchor: string }> = {
  cuiaba: { dx: 14, dy: 22, anchor: 'start' },
  goiania: { dx: -14, dy: 24, anchor: 'end' },
  brasilia: { dx: 14, dy: -12, anchor: 'start' },
};
const cidade = (slug: string) => CIDADES.find((c) => c.slug === slug)!;
// GO vem antes do DF para o DF ficar por cima
const ordem = [...estados].sort((a, b) => (a.uf === 'DF' ? 1 : b.uf === 'DF' ? -1 : 0));
---
<svg class="mapa" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="mapa-titulo">
  <title id="mapa-titulo">Mapa de Mato Grosso, Goiás e Distrito Federal com os escritórios em Cuiabá, Goiânia e Brasília</title>
  <g class="mapa__vizinhos" aria-hidden="true">
    {vizinhos.map((v) => <path d={v.d} />)}
  </g>
  {ordem.map((e) => (
    <a href={`/advogados-em-${capitalDe[e.uf]}/`} class={`mapa__estado mapa__estado--${e.uf.toLowerCase()}`} aria-label={`${nomeEstado[e.uf]}: advogados em ${cidade(capitalDe[e.uf]).nome}`}>
      <path d={e.d} />
    </a>
  ))}
  <g class="mapa__rotulos" aria-hidden="true">
    {(['MT', 'GO'] as const).map((uf) => <text x={rotulos[uf][0]} y={rotulos[uf][1]} text-anchor="middle">{nomeEstado[uf]}</text>)}
  </g>
  <g class="mapa__cidades" aria-hidden="true">
    {Object.entries(pontos).map(([slug, [x, y]]) => (
      <g class="mapa__cidade">
        <circle class="mapa__pulso" cx={x} cy={y} r="7" />
        <circle class="mapa__ponto" cx={x} cy={y} r="5" />
        <text x={x + rotuloCidade[slug].dx} y={y + rotuloCidade[slug].dy} text-anchor={rotuloCidade[slug].anchor}>{cidade(slug).nome}</text>
      </g>
    ))}
  </g>
</svg>
