---
// Carrossel da equipe: retratos grandes, rolagem automática com pausa ao interagir.
// Na versão publicada só aparece quem tiver NOME preenchido em EQUIPE (src/data/site.ts).
import { Image } from 'astro:assets';
import { EQUIPE } from '../data/site';
import type { ImageMetadata } from 'astro';
const arquivos = import.meta.glob<{ default: ImageMetadata }>('../assets/equipe/*.{jpg,jpeg,png,webp}', { eager: true });
const fotoDe = (nome: string) => Object.entries(arquivos).find(([p]) => p.endsWith('/' + nome))?.[1].default;
const previa = process.env.PREVIA_EQUIPE === '1';
const pessoas = EQUIPE.map((p) => ({ ...p, img: fotoDe(p.foto) })).filter((p) => p.img && (p.nome || previa));
---
{pessoas.length > 0 && (
  <section id="equipe" class="secao secao--marinho equipe" aria-labelledby="equipe-titulo">
    <div class="conteiner">
      <div class="equipe__topo">
        <div>
          <h2 id="equipe-titulo" class="titulo titulo--claro" data-revelar>Quem cuida do seu caso</h2>
          <p class="paragrafo paragrafo--claro equipe__intro" data-revelar>Advogados que atendem, estudam e acompanham cada processo do início ao fim.</p>
        </div>
        <div class="equipe__setas">
          <button type="button" class="equipe__seta" data-dir="-1" aria-label="Advogado anterior">‹</button>
          <button type="button" class="equipe__seta" data-dir="1" aria-label="Próximo advogado">›</button>
        </div>
      </div>
    </div>
    <ul class="equipe__trilho" data-trilho aria-label="Equipe de advogados">
      {pessoas.map((p) => (
        <li class="pessoa">
          <Image src={p.img!} alt={p.nome ? `${p.nome}, ${p.cargo.toLowerCase()} do escritório` : p.cargo} widths={[400, 640, 900, 1086]} sizes="(max-width: 600px) 80vw, 380px" quality={88} class="pessoa__foto" />
          <div class="pessoa__texto">
            <p class="pessoa__nome">{p.nome || 'Nome a confirmar'}</p>
            <p class="pessoa__cargo">{p.cargo}{p.oab && ` · ${p.oab}`}</p>
          </div>
        </li>
      ))}
    </ul>
    <div class="conteiner"><div class="equipe__progresso" aria-hidden="true"><span></span></div></div>
  </section>
)}
<script>
  const trilho = document.querySelector<HTMLElement>('[data-trilho]');
  const barra = document.querySelector<HTMLElement>('.equipe__progresso span');
  if (trilho) {
    const INTERVALO = 3500;
    const passo = () => {
      const card = trilho.querySelector<HTMLElement>('.pessoa');
      const gap = parseFloat(getComputedStyle(trilho).columnGap) || 0;
      return (card?.offsetWidth ?? 300) + gap;
    };
    let decorrido = 0;
    const reiniciar = () => { decorrido = 0; };
    const avancar = (dir = 1) => {
      const fim = trilho.scrollLeft + trilho.clientWidth >= trilho.scrollWidth - 8;
      const inicio = trilho.scrollLeft <= 4;
      if (dir > 0 && fim) trilho.scrollTo({ left: 0, behavior: 'smooth' });
      else if (dir < 0 && inicio) trilho.scrollTo({ left: trilho.scrollWidth, behavior: 'smooth' });
      else trilho.scrollBy({ left: dir * passo(), behavior: 'smooth' });
    };
    document.querySelectorAll<HTMLButtonElement>('.equipe__seta').forEach((b) =>
      b.addEventListener('click', () => { avancar(Number(b.dataset.dir)); reiniciar(); }),
    );

    // rolagem automática: pausa com o mouse em cima, com foco, ao tocar e fora da tela
    const calmo = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let pausado = false, visivel = false, ultimo = 0, pausaAte = 0;
    const quadro = (t: number) => {
      const dt = ultimo ? t - ultimo : 0;
      ultimo = t;
      if (visivel && !pausado && t > pausaAte && !document.hidden) {
        decorrido += dt;
        if (decorrido >= INTERVALO) { decorrido = 0; avancar(1); }
      }
      if (barra) barra.style.transform = `scaleX(${Math.min(decorrido / INTERVALO, 1)})`;
      requestAnimationFrame(quadro);
    };
    if (!calmo) requestAnimationFrame(quadro);
    trilho.addEventListener('mouseenter', () => (pausado = true));
    trilho.addEventListener('mouseleave', () => (pausado = false));
    trilho.addEventListener('focusin', () => (pausado = true));
    trilho.addEventListener('focusout', () => (pausado = false));
    trilho.addEventListener('touchstart', () => { pausaAte = performance.now() + 6000; reiniciar(); }, { passive: true });
    new IntersectionObserver(([e]) => { visivel = e.isIntersecting; }, { threshold: 0.3 }).observe(trilho);
  }
</script>
