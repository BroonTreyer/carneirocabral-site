---
// Carrossel da equipe: retratos grandes, passando sozinho em loop infinito.
// Na versão publicada só aparece quem tiver NOME preenchido em EQUIPE (src/data/site.ts).
import { Image } from 'astro:assets';
import { EQUIPE } from '../data/site';
import type { ImageMetadata } from 'astro';
const arquivos = import.meta.glob<{ default: ImageMetadata }>('../assets/equipe/*.{jpg,jpeg,png,webp}', { eager: true });
const fotoDe = (nome: string) => Object.entries(arquivos).find(([p]) => p.endsWith('/' + nome))?.[1].default;
const previa = process.env.PREVIA_EQUIPE === '1';
const pessoas = EQUIPE.map((p) => ({ ...p, img: fotoDe(p.foto) })).filter((p) => p.img && (p.nome || previa));
// a lista é repetida uma vez para o loop não ter "volta ao início" visível
const voltas = [0, 1];
---
{pessoas.length > 0 && (
  <section id="equipe" class="secao secao--marinho equipe" aria-labelledby="equipe-titulo">
    <div class="conteiner">
      <div class="equipe__topo">
        <div>
          <h2 id="equipe-titulo" class="titulo titulo--claro" data-revelar>Quem cuida do seu caso</h2>
          <p class="paragrafo paragrafo--claro equipe__intro" data-revelar>Advogados que atendem, estudam e acompanham cada processo do início ao fim.</p>
        </div>
        <div class="equipe__setas">
          <button type="button" class="equipe__seta equipe__pausa" aria-pressed="false" aria-label="Pausar a esteira de fotos"><span aria-hidden="true">❚❚</span></button>
        </div>
      </div>
    </div>
    <div class="esteira" data-esteira>
    <ul class="esteira__faixa" aria-label="Equipe de advogados" style={`--duracao: ${pessoas.length * 9}s`}>
      {voltas.map((v) => pessoas.map((p) => (
        <li class="pessoa" aria-hidden={v === 1 ? 'true' : undefined} data-copia={v === 1 ? '' : undefined}>
          <Image src={p.img!} alt={v === 1 ? '' : p.nome ? `${p.nome}, ${p.cargo.toLowerCase()} do escritório` : p.cargo} widths={[400, 640, 900, 1086]} sizes="(max-width: 600px) 80vw, 380px" quality={88} class="pessoa__foto" />
          <div class="pessoa__texto">
            <p class="pessoa__nome">{p.nome || 'Nome a confirmar'}</p>
            <p class="pessoa__cargo">{p.cargo}{p.oab && ` · ${p.oab}`}</p>
          </div>
        </li>
      )))}
    </ul>
    </div>
  </section>
)}
<script>
  // esteira contínua (animação CSS); o botão só pausa e retoma
  const esteira = document.querySelector<HTMLElement>('[data-esteira]');
  const pausa = document.querySelector<HTMLButtonElement>('.equipe__pausa');
  pausa?.addEventListener('click', () => {
    const parado = esteira?.classList.toggle('esteira--parada') ?? false;
    pausa.setAttribute('aria-pressed', String(parado));
    pausa.setAttribute('aria-label', parado ? 'Retomar a esteira de fotos' : 'Pausar a esteira de fotos');
    pausa.firstElementChild!.textContent = parado ? '▶' : '❚❚';
  });
</script>
