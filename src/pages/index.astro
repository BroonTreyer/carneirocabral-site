---
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Monograma from '../components/Monograma.astro';
import Mapa from '../components/Mapa.astro';
import Contato from '../components/Contato.astro';
import Icone from '../components/Icone.astro';
import Numeros from '../components/Numeros.astro';
import Equipe from '../components/Equipe.astro';
import { AREAS, ETAPAS, PERGUNTAS, CIDADES, PILARES, TELEFONES } from '../data/site';
import { foto } from '../data/fotos';

const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: PERGUNTAS.map((q) => ({ '@type': 'Question', name: q.p, acceptedAnswer: { '@type': 'Answer', text: q.r } })),
};
const msg = encodeURIComponent('Olá! Vim pelo site e gostaria de agendar um atendimento.');
---
<Base
  titulo="Carneiro Cabral Advogados Associados | Goiânia, Cuiabá e Brasília"
  descricao="Escritório com mais de 25 mil processos acompanhados e 11 advogados em Goiânia, Cuiabá e Brasília. Civil, Consumidor, Empresarial, Trabalho, Agro e Família."
  schema={[faq]}
>
  <!-- Abertura: a recepção do escritório, com a marca como na parede -->
  <section class="abertura" aria-labelledby="titulo-principal">
    <div class="abertura__foto" aria-hidden="true">
      <Image src={foto('escritorio-recepcao')} widths={[768, 1200, 1536]} sizes="100vw" alt="" loading="eager" fetchpriority="high" class="abertura__img" />
    </div>
    <span class="abertura__moldura" aria-hidden="true"></span>
    <div class="abertura__grade conteiner">
      <div class="abertura__texto">
        <span class="abertura__filete" aria-hidden="true"></span>
        <h1 id="titulo-principal" class="abertura__titulo">Do campo aos tribunais superiores.</h1>
        <p class="abertura__lead">Defendemos pessoas, empresas e produtores rurais em Goiânia, Cuiabá e Brasília, com uma equipe de 11 advogados e um compromisso simples: estudar cada caso a fundo e explicar tudo com clareza.</p>
        <div class="abertura__acoes">
          <a class="botao botao--ouro" href="#contato">Agendar atendimento</a>
          <a class="botao botao--contorno" href={`https://wa.me/${TELEFONES.brasilia.whatsapp}?text=${msg}`} target="_blank" rel="noopener"><Icone nome="whatsapp" class="botao__icone" />Falar pelo WhatsApp</a>
        </div>
      </div>
    </div>
    <div class="abertura__base">
      <div class="conteiner"><Numeros /></div>
    </div>
  </section>

  <!-- O escritório -->
  <section id="escritorio" class="secao secao--pedra" aria-labelledby="escritorio-titulo">
    <div class="conteiner manifesto">
      <div class="manifesto__texto">
        <h2 id="escritorio-titulo" class="titulo" data-revelar>Por trás de cada número de processo, há alguém esperando uma resposta.</h2>
        <p class="paragrafo paragrafo--destaque" data-revelar>Uma família à espera de um inventário. Uma empresa que precisa continuar funcionando. Uma safra que não pode parar por causa de um contrato mal resolvido.</p>
        <p class="paragrafo" data-revelar>Com escritórios em Goiânia, Cuiabá e Brasília, o Carneiro Cabral conhece as distâncias e o ritmo do Centro-Oeste. E sabe que, para quem nos procura, o problema é sempre urgente.</p>
        <p class="paragrafo" data-revelar>São mais de 25 mil processos acompanhados, e cada um segue o mesmo método: ler tudo, explicar tudo e decidir junto com o cliente.</p>
      </div>
      <figure class="colagem" data-revelar>
        <Image src={foto('escritorio-reuniao')} widths={[480, 768, 1024]} sizes="(max-width: 960px) 90vw, 40vw" alt="Sala de reuniões do escritório, com mesa de madeira e o logo Carneiro Cabral na parede" class="colagem__principal" />
        <Image src={foto('escritorio-corredor')} widths={[360, 560]} sizes="(max-width: 960px) 50vw, 20vw" alt="Corredor do escritório com as salas dos advogados" class="colagem__detalhe" />
      </figure>
    </div>
    <div class="conteiner">
      <div class="pilares">
        {PILARES.map((p) => (
          <div class="pilar" data-revelar>
            <h3 class="pilar__titulo">{p.titulo}</h3>
            <p class="pilar__texto">{p.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Áreas -->
  <section id="atuacao" class="secao secao--marinho" aria-labelledby="atuacao-titulo">
    <div class="conteiner">
      <div class="cabeca-secao">
        <h2 id="atuacao-titulo" class="titulo titulo--claro" data-revelar>Áreas de atuação</h2>
        <p class="paragrafo paragrafo--claro" data-revelar>Atuamos de forma consultiva, para evitar o conflito, e contenciosa, quando é preciso defender seus direitos na Justiça. Escolha uma área para ver como podemos ajudar.</p>
      </div>
      <ul class="areas-grade">
        {AREAS.map((a) => (
          <li class="area-card" data-revelar>
            <a class="area-card__link" href={`/atuacao/${a.slug}/`}>
              <Icone nome={a.icone} class="area-card__icone" />
              <h3 class="area-card__titulo">{a.titulo}</h3>
              <p class="area-card__texto">{a.texto}</p>
              <span class="area-card__mais">Saiba mais <Icone nome="seta" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Campo -->
  <section class="lavoura" aria-labelledby="lavoura-titulo">
    <div class="lavoura__foto">
      <Image src={foto('agro-colheita-soja')} widths={[640, 1024, 1600]} sizes="(max-width: 860px) 100vw, 55vw" alt="Colheitadeira trabalhando em lavoura de soja em Mato Grosso" class="lavoura__img" />
    </div>
    <div class="lavoura__texto">
      <h2 id="lavoura-titulo" class="titulo" data-revelar>Advocacia para quem produz.</h2>
      <p class="paragrafo paragrafo--destaque" data-revelar>Goiás e Mato Grosso estão entre os maiores produtores de grãos do país. Na região, o direito do campo faz parte do dia a dia de famílias, produtores e empresas.</p>
      <p class="paragrafo" data-revelar>Contratos de arrendamento e parceria, compra e venda de safra, crédito rural, regularização de áreas e sucessão da propriedade familiar: são questões que pedem conhecimento técnico e a compreensão de como a atividade funciona na prática, do plantio à entrega.</p>
      <a class="botao botao--marinho" href="/atuacao/direito-agrario-e-agronegocio/" data-revelar>Conhecer a atuação no agronegócio</a>
    </div>
  </section>

  <!-- Brasília -->
  <section class="destaque" aria-labelledby="destaque-titulo">
    <Image src={foto('stf-a-justica')} widths={[800, 1280, 2000]} sizes="100vw" alt="Escultura A Justiça, de Alfredo Ceschiatti, diante do Supremo Tribunal Federal, iluminada à noite" class="destaque__img" />
    <div class="destaque__veu" aria-hidden="true"></div>
    <div class="conteiner destaque__conteudo">
      <h2 id="destaque-titulo" class="destaque__titulo" data-revelar>Quando o processo chega a Brasília, nós já estamos lá.</h2>
      <p class="destaque__texto" data-revelar>Recurso em tribunal superior pede presença: entrega de memoriais, despachos e sustentações orais. Do nosso escritório na capital federal, acompanhamos de perto os processos que sobem de Goiás e de Mato Grosso ao STJ, ao TST e ao STF.</p>
    </div>
  </section>

  <Equipe />

  <!-- Método -->
  <section id="como-trabalhamos" class="secao secao--pedra" aria-labelledby="etapas-titulo">
    <div class="conteiner">
      <div class="cabeca-secao">
        <h2 id="etapas-titulo" class="titulo" data-revelar>Como trabalhamos</h2>
        <p class="paragrafo" data-revelar>Do primeiro contato ao fim do processo, você sabe em que etapa está e o que vem a seguir.</p>
      </div>
      <ol class="etapas">
        {ETAPAS.map((e, i) => (
          <li class="etapa" data-revelar>
            <span class="etapa__num" aria-hidden="true">{i + 1}</span>
            <h3 class="etapa__titulo">{e.titulo}</h3>
            <p class="etapa__texto">{e.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Cidades -->
  <section id="onde-estamos" class="secao secao--marinho" aria-labelledby="onde-titulo">
    <div class="conteiner">
      <div class="onde">
        <div class="onde__texto">
          <h2 id="onde-titulo" class="titulo titulo--claro" data-revelar>Três capitais, uma só equipe.</h2>
          <p class="paragrafo paragrafo--claro" data-revelar>Os escritórios de Goiânia, Cuiabá e Brasília trabalham juntos. Um caso que começa em uma cidade pode contar com a equipe das outras duas sempre que for preciso.</p>
        </div>
        <Mapa />
      </div>
      <ul class="cidades-grade">
        {CIDADES.map((c) => (
          <li class="cidade-card" data-revelar>
            <a class="cidade-card__link" href={`/advogados-em-${c.slug}/`}>
              <Image src={foto(c.foto)} widths={[480, 720]} sizes="(max-width: 860px) 100vw, 33vw" alt={c.legenda} class="cidade-card__img" />
              <span class="cidade-card__corpo">
                <span class="cidade-card__nome">{c.nome}</span>
                <span class="cidade-card__estado">{c.estado}</span>
                <span class="cidade-card__tel">{c.telefone.exibicao}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="perguntas" class="secao secao--pedra perguntas" aria-labelledby="faq-titulo">
    <div class="conteiner perguntas__grade">
      <figure class="perguntas__estatua" aria-hidden="true">
        <Picture src={foto('temis')} formats={['avif', 'webp']} widths={[360, 560]} sizes="(max-width: 960px) 0px, 26vw" alt="" class="perguntas__img" />
      </figure>
      <div>
        <h2 id="faq-titulo" class="titulo" data-revelar>Perguntas frequentes</h2>
        <div class="faq" data-revelar>
          {PERGUNTAS.map((q) => (
            <details class="faq__item">
              <summary>{q.p}</summary>
              <p>{q.r}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Contato />
</Base>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.registerPlugin(ScrollTrigger);
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
    tl.fromTo('.abertura__img', { scale: 1.12 }, { scale: 1, duration: 2.8, ease: 'power2.out' })
      .from('.abertura__moldura', { opacity: 0, scale: 1.03, duration: 1.6 }, '<0.4')
      .from('.abertura__filete', { scaleX: 0, duration: 1.1, ease: 'power3.inOut' }, '<0.3')
      .from('.abertura__titulo', { opacity: 0, y: 18, duration: 1 }, '<0.3')
      .from('.abertura__lead', { opacity: 0, y: 12, duration: 0.9 }, '<0.15')
      .from('.abertura__acoes .botao', { opacity: 0, y: 8, duration: 0.7, stagger: 0.1 }, '<0.15')
      .from('.abertura__base', { opacity: 0, duration: 0.8 }, '<0.2');
    // profundidade ao rolar
    gsap.to('.abertura__foto', { yPercent: 12, ease: 'none', scrollTrigger: { trigger: '.abertura', start: 'top top', end: 'bottom top', scrub: true } });
    gsap.fromTo('.destaque__img', { yPercent: -8 }, { yPercent: 8, ease: 'none', scrollTrigger: { trigger: '.destaque', start: 'top bottom', end: 'bottom top', scrub: true } });
    gsap.fromTo('.lavoura__img', { scale: 1.12 }, { scale: 1, ease: 'none', scrollTrigger: { trigger: '.lavoura', start: 'top bottom', end: 'center center', scrub: true } });
  }
</script>
